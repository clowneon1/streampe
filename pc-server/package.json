{
  "name": "streampe-server",
  "version": "2.4.1",
  "description": "StreamPe - PC Server App",
  "author": "clowneon1",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch server.js server.js",
    "test": "node tests/run-all-tests.js",
    "build": "node scripts/package-release.js",
    "build:patch": "node scripts/package-release.js patch",
    "build:minor": "node scripts/package-release.js minor",
    "build:major": "node scripts/package-release.js major",
    "dist": "node scripts/package-release.js",
    "dist:patch": "node scripts/package-release.js patch",
    "dist:minor": "node scripts/package-release.js minor",
    "dist:major": "node scripts/package-release.js major",
    "bun:build": "node scripts/build-bun-sidecar.js",
    "app:dev": "node scripts/build-bun-sidecar.js && tauri dev",
    "app:dist": "node scripts/package-release.js",
    "version": "node scripts/sync-version.js && git add src-tauri/Cargo.toml src-tauri/tauri.conf.json constants.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "bonjour-service": "^1.4.4",
    "express": "^4.18.2",
    "handlebars": "^4.7.8",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "nodemon": "^3.0.1"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "scripts": [
      "server.js"
    ]
  }
}
