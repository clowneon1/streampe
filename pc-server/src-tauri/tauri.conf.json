{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamPe",
  "identifier": "com.clowneon1.streampe",
  "version": "2.1.0",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": null,
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "StreamPe",
        "width": 480,
        "height": 640,
        "minWidth": 440,
        "minHeight": 580,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "clowneon1",
    "copyright": "Copyright © 2026 clowneon1",
    "category": "Utility",
    "shortDescription": "StreamPe - Live Payment Alerts Overlay",
    "longDescription": "StreamPe desktop app and OBS overlay server for payment notifications",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "sidecars/server"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
