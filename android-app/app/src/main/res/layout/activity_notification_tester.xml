<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&#x1F514; Notification Tester"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_marginBottom="4dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fire test notifications to verify forwarding to OBS"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginBottom="24dp" />

        <!-- Preset selector -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRESET"
            android:textSize="11sp"
            android:textColor="#666666"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1e1e1e"
            android:padding="4dp"
            android:layout_marginBottom="20dp" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TITLE"
            android:textSize="11sp"
            android:textColor="#666666"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etNotifTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Google Pay"
            android:inputType="text"
            android:background="#1e1e1e"
            android:textColor="#ffffff"
            android:textColorHint="#555555"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <!-- Text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MESSAGE"
            android:textSize="11sp"
            android:textColor="#666666"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etNotifText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. You received &#x20B9;500 from Rahul"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:background="#1e1e1e"
            android:textColor="#ffffff"
            android:textColorHint="#555555"
            android:padding="14dp"
            android:layout_marginBottom="24dp"
            android:gravity="top" />

        <Button
            android:id="@+id/btnFireNotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&#x1F514;  Fire Notification"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- Log -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FIRED LOG"
            android:textSize="11sp"
            android:textColor="#666666"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No notifications fired yet"
            android:textSize="12sp"
            android:textColor="#00ff88"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:background="#0d1f0d" />

    </LinearLayout>
</ScrollView>
