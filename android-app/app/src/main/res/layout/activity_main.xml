<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ══ Top App Bar ══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="10dp"
            android:contentDescription="App icon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Payment Alerts for OBS"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/textMain" />

        <!-- Live dot indicator -->
        <TextView
            android:id="@+id/tvLiveDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/success"
            android:letterSpacing="0.08"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Border -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" />

    <!-- ══ Scrollable content ═════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- ── SERVER CONNECTION ──────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SERVER CONNECTION"
                android:textSize="10sp"
                android:textColor="@color/accent"
                android:letterSpacing="0.12"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Server card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface1"
                android:padding="16dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PC Server URL"
                    android:textSize="11sp"
                    android:textColor="@color/textMuted"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etServerUrl"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:hint="http://192.168.1.x:2709"
                        android:inputType="text"
                        android:background="@color/surface2"
                        android:textColor="@color/textMain"
                        android:textColorHint="@color/border"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp"
                        android:singleLine="true" />

                    <Button
                        android:id="@+id/btnConnect"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:text="Connect"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:enabled="false"
                        android:alpha="0.4"
                        android:backgroundTint="@color/accent"
                        android:textColor="#000000"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:stateListAnimator="@null" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="@color/danger"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/border" android:layout_marginBottom="24dp" />

            <!-- ── PERMISSIONS ────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PERMISSIONS"
                android:textSize="10sp"
                android:textColor="@color/accent"
                android:letterSpacing="0.12"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Notification Access card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/surface1"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notification Access"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/textMain"
                        android:layout_marginBottom="3dp" />

                    <TextView
                        android:id="@+id/tvNotifAccess"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checking…"
                        android:textSize="11sp"
                        android:textColor="@color/textMuted" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnPermission"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Enable"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/accent"
                    android:textColor="#000000"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <!-- POST_NOTIFICATIONS (Android 13+) card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/surface1"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="App Notifications"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/textMain"
                        android:layout_marginBottom="3dp" />

                    <TextView
                        android:id="@+id/tvPermStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checking…"
                        android:textSize="11sp"
                        android:textColor="@color/textMuted" />

                </LinearLayout>

            </LinearLayout>

            <!-- Battery card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/surface1"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Battery Optimization"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/textMain"
                        android:layout_marginBottom="3dp" />

                    <TextView
                        android:id="@+id/tvBatteryStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checking…"
                        android:textSize="11sp"
                        android:textColor="@color/textMuted" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnBatteryOptimization"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Fix"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/surface2"
                    android:textColor="@color/accent"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <!-- Accessibility card — OPTIONAL with warning -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface1"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="3dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Accessibility Access"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/textMain"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="OPTIONAL"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:background="@color/textMuted"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:paddingTop="1dp"
                                android:paddingBottom="1dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAccessibilityStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking…"
                            android:textSize="11sp"
                            android:textColor="@color/textMuted" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnAccessibility"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Enable"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/surface2"
                        android:textColor="@color/textMuted"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:stateListAnimator="@null" />

                </LinearLayout>

                <!-- Warning banner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#1a150a"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠"
                        android:textSize="13sp"
                        android:textColor="#f0a500"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="May interfere with some payment apps. PhonePe works without this — only enable if needed for Amazon Pay."
                        android:textSize="11sp"
                        android:textColor="#c8901a"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
