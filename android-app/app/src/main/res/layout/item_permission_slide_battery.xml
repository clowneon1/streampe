<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0a0c14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2. Battery Keepalive"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#F0F2FF" />

            <TextView
                android:id="@+id/tvSlide2Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECOMMENDED"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FBBF24"
                android:background="#262208"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keeps alerts connected in the background when the phone screen is locked or idle."
            android:textSize="13sp"
            android:textColor="#8890AA"
            android:layout_marginBottom="16dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#12151f"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvSlide2Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Battery Optimization is active."
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FBBF24" />

        </LinearLayout>

        <!-- Concise Reason Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#141824"
            android:padding="14dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ Why disable restrictions?"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#00E5FF"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prevents Android from putting the app to sleep, ensuring uninterrupted alert delivery during long streams."
                android:textSize="12sp"
                android:textColor="#C3C9DD"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- Action Button -->
        <Button
            android:id="@+id/btnGrantSlide2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Disable Battery Restrictions"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FBBF24"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>
