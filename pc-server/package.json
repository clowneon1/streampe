{
  "name": "payment-alerts-obs-server",
  "version": "1.0.0",
  "description": "Payment Alerts for OBS - PC Server App",
  "author": "clowneon1",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch server.js server.js",
    "app:start": "npx electron .",
    "app:dist": "npx electron-builder --win zip"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "28.2.0",
    "electron-builder": "^24.9.0",
    "nodemon": "^3.0.1"
  },
  "build": {
    "appId": "com.clowneon1.paymentalerts",
    "productName": "Payment Alerts for OBS",
    "copyright": "Copyright © 2026 clowneon1",
    "electronVersion": "28.2.0",
    "directories": {
      "output": "dist-portable"
    },
    "files": [
      "main.js",
      "server.js",
      "public/**/*"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "icon": "public/icon.png"
    }
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "scripts": [
      "server.js"
    ]
  }
}