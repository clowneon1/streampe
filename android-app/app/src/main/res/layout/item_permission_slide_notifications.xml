<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0a0c14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1. Notification Access"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#F0F2FF" />

            <TextView
                android:id="@+id/tvSlide1Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REQUIRED"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#F87171"
                android:background="#2d1515"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Required to detect incoming payments from PhonePe, Google Pay, and Amazon Pay."
            android:textSize="13sp"
            android:textColor="#8890AA"
            android:layout_marginBottom="16dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#12151f"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvSlide1Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔴 Notification Access is NOT granted."
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F87171" />

        </LinearLayout>

        <!-- Quick Tip Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#141824"
            android:padding="14dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📱 If Android blocks as 'Restricted setting':"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#00E5FF"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Tap 'App Info' below\n2. Tap ⋮ (top-right) ➔ 'Allow restricted settings'\n3. Return here and tap 'Grant Notification Access'"
                android:textSize="12sp"
                android:textColor="#C3C9DD"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnGrantSlide1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Grant Notification Access"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6C63FF"
            android:layout_marginBottom="8dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnAppInfoSlide1"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Open App Info (Restricted Fix)"
            android:textSize="12sp"
            android:textColor="#00E5FF"
            android:backgroundTint="#1a1d2b"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>
