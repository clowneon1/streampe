<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0c14">

    <!-- ══ TOP APP BAR ══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#12151f"
        android:elevation="8dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerInside"
            android:background="#1a1d2b"
            android:padding="4dp"
            android:contentDescription="App Logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Payment Alerts for OBS"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#F0F2FF"
            android:paddingStart="10dp" />

    </LinearLayout>

    <!-- Connection Status Bar -->
    <TextView
        android:id="@+id/tvServerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0f1208"
        android:textColor="#4ADE80"
        android:textSize="11sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical" />

    <!-- ══ SEARCH BAR ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="#12151f">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Search apps…"
            android:inputType="text"
            android:background="#1a1d2b"
            android:textColor="#F0F2FF"
            android:textColorHint="#555D7A"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2e3248" />

    <!-- App list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2e3248" />

    <!-- ══ FOOTER ACTIONS ════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="#12151f">

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save Selection"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#6C63FF"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:stateListAnimator="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnTest"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Test Alert"
                android:textSize="12sp"
                android:textColor="#6C63FF"
                android:backgroundTint="#1a1830"
                android:layout_marginEnd="6dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnAlertLog"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Donations"
                android:textSize="12sp"
                android:textColor="#6C63FF"
                android:backgroundTint="#1a1830"
                android:layout_marginStart="6dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Disconnect"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@null"
            android:layout_marginTop="12dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>
