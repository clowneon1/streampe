<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0c14">

    <!-- ══ TOP APP BAR ══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#12151f"
        android:elevation="8dp">

        <!-- App icon -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerInside"
            android:background="#1a1d2b"
            android:padding="4dp"
            android:contentDescription="App Logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="StreamPe"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#F0F2FF"
            android:paddingStart="10dp" />

        <Button
            android:id="@+id/btnOpenPermissions"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="⚙️ Setup"
            android:textSize="11sp"
            android:textColor="#00E5FF"
            android:backgroundTint="#1a1d2b"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- ══ SCROLLABLE CONTENT ═══════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── AUTO-DISCOVERY CARD ─────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AUTO-DISCOVER PC SERVER (WI-FI)"
                android:textSize="10sp"
                android:textColor="#555D7A"
                android:letterSpacing="0.15"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#12151f"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ProgressBar
                        android:id="@+id/pbDiscovery"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:indeterminateTint="#00E5FF"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvDiscoveryStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Scanning local Wi-Fi for PC server..."
                        android:textSize="12sp"
                        android:textColor="#00E5FF" />

                    <Button
                        android:id="@+id/btnRefreshDiscovery"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Scan"
                        android:textSize="11sp"
                        android:textColor="#F0F2FF"
                        android:backgroundTint="#1a1d2b"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:stateListAnimator="@null" />

                </LinearLayout>

                <!-- Dynamic container for discovered servers -->
                <LinearLayout
                    android:id="@+id/layoutDiscoveredServers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- ── MANUAL SERVER CONNECTION CARD ───────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MANUAL CONNECTION / RECENT SERVERS"
                android:textSize="10sp"
                android:textColor="#555D7A"
                android:letterSpacing="0.15"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#12151f"
                android:padding="16dp"
                android:layout_marginBottom="4dp">

                <!-- Saved servers horizontal container -->
                <LinearLayout
                    android:id="@+id/layoutSavedServersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent / Saved Servers:"
                        android:textSize="11sp"
                        android:textColor="#8890AA"
                        android:layout_marginBottom="6dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layoutSavedServersChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PC Server URL or IP:Port"
                    android:textSize="12sp"
                    android:textColor="#8890AA"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="http://192.168.1.x:2907"
                    android:inputType="text"
                    android:background="#1a1d2b"
                    android:textColor="#F0F2FF"
                    android:textColorHint="#555D7A"
                    android:textSize="14sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Connect to Server"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#6C63FF"
                    android:enabled="false"
                    android:alpha="0.5"
                    android:stateListAnimator="@null" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#F87171"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- ── INFO FOOTER ──────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Works with PhonePe, Google Pay, Amazon Pay &amp; Cash."
                android:textSize="12sp"
                android:textColor="#555D7A"
                android:gravity="center"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
