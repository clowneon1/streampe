<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0c14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔔 Notification Tester"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#F0F2FF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a preset to pre-fill, then edit any field freely."
            android:textSize="13sp"
            android:textColor="#8890AA"
            android:layout_marginBottom="16dp" />

        <!-- Preset picker -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Template"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F0F2FF"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_spinner"
            android:popupBackground="#12151f"
            android:padding="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notification Title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F0F2FF"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNotifTitle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="e.g. PhonePe"
            android:inputType="text"
            android:background="#1a1d2b"
            android:textColor="#F0F2FF"
            android:textColorHint="#555D7A"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="12dp" />

        <!-- Text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notification Text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F0F2FF"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNotifText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Rahul sent ₹500 to your account"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:background="#1a1d2b"
            android:textColor="#F0F2FF"
            android:textColorHint="#555D7A"
            android:padding="14dp"
            android:layout_marginBottom="12dp" />

        <!-- Package -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Package Name (optional)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F0F2FF"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNotifPkg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="e.g. com.phonepe.app"
            android:inputType="text"
            android:background="#1a1d2b"
            android:textColor="#F0F2FF"
            android:textColorHint="#555D7A"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="20dp" />

        <!-- Fire button -->
        <Button
            android:id="@+id/btnFireNotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔔 Fire &amp; Send to OBS"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← Back"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginBottom="16dp" />

        <!-- Log -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recent Sends"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F0F2FF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#8890AA" />

    </LinearLayout>
</ScrollView>
